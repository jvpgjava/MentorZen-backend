						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"token\", response.token);",
									"    pm.environment.set(\"userId\", response.user.id);",
									"    console.log(\"Token salvo automaticamente!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
