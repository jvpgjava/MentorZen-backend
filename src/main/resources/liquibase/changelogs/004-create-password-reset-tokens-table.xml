<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-password-reset-tokens-table" author="JGrando">
        <comment>Criar tabela para tokens de recuperação de senha</comment>
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="password_reset_tokens"
                baseColumnNames="user_id"
                constraintName="fk_password_reset_tokens_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_token">
            <column name="token"/>
        </createIndex>

        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_valid">
            <column name="user_id"/>
            <column name="used"/>
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
