<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-add-user-profile-fields" author="JGrando">
        <comment>Adicionar campos de telefone e foto de perfil na tabela users</comment>

        <addColumn tableName="users">
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="users">
            <column name="profile_picture_url" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="users" indexName="idx_users_phone">
            <column name="phone"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
